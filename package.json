{
  "name": "raj-colaco-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test:portfolio": "esbuild tests/portfolio-projects.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/portfolio-projects.test.mjs --log-level=warning && node node_modules/.cache/portfolio-projects.test.mjs",
    "verify:journey": "esbuild scripts/journey-verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/journey-verify.mjs --log-level=warning && node node_modules/.cache/journey-verify.mjs",
    "verify:journey:visual": "node scripts/journey-visual-verify.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/topojson-client": "^3.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
